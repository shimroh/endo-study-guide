const checked = id => $(id).checked;
const fmt = (v,d=2) => Number.isFinite(v) ? v.toFixed(d) : '—';
const status = (text, cls='blue') => `<span class="status ${cls}">${text}</span>`;

$('search').addEventListener('input', () => {
  const q = $('search').value.trim().toLowerCase();
  document.querySelectorAll('.searchable').forEach(el => {
    el.classList.toggle('hiddenBySearch', q && !el.innerText.toLowerCase().includes(q));
  });
});

function listHTML(items){ return `<ul class="tight">${items.map(x=>`<li>${x}</li>`).join('')}</ul>`; }

function interpretCase(){
  const age=num('age'), sex=$('sex').value, ca=num('ca'), cauln=num('cauln'), alb=num('albumin');
  const ion=num('ionca'), ionuln=num('ioncauln'), pth=num('pth'), pthlln=num('pthlln'), pthuln=num('pthuln');
  const vitd=num('vitd'), egfr=num('egfr'), urineCa=num('urineCa'), urineCr=num('urineCr'), serumCr=num('serumCr');
  const tScore=num('tScore');
  const corrected = (ca!==null && alb!==null) ? ca + 0.8*(4-alb) : null;
  const effectiveCa = ion!==null && ionuln!==null ? null : (corrected!==null ? corrected : ca);
  const hyperByIon = ion!==null && ionuln!==null ? ion>ionuln : false;
  const hyperByTotal = effectiveCa!==null && cauln!==null ? effectiveCa>cauln : false;
  const hyper = hyperByIon || hyperByTotal;
  const clearlyNormalCa = ((ion!==null && ionuln!==null && ion<=ionuln) || ion===null) && ((effectiveCa!==null && cauln!==null && effectiveCa<=cauln) || effectiveCa===null);
  const pthHigh = pth!==null && pthuln!==null && pth>pthuln;
  const pthSuppressed = pth!==null && pthlln!==null && pth<pthlln;
  const pthNonsuppressed = pth!==null && !pthSuppressed;

  let cOut=[];
  if(ca===null && ion===null){ cOut.push(status('Insufficient data','amber'),'Enter total or ionized calcium.'); }
  else {
    if(ca!==null) cOut.push(`Measured total calcium: <strong>${fmt(ca)}</strong> mg/dL.`);
    if(corrected!==null) cOut.push(`Estimated albumin-adjusted calcium: <strong>${fmt(corrected)}</strong> mg/dL.`);
    if(ion!==null) cOut.push(`Ionized calcium: <strong>${ion}</strong>${ionuln!==null?` (ULN ${ionuln})`:''}.`);
    if(hyper) cOut.unshift(status('Hypercalcemia supported','red'));
    else cOut.unshift(status('Hypercalcemia not established','amber'));
    if(alb!==null && Math.abs(alb-4)>=0.7) cOut.push('Because albumin is substantially abnormal, ionized calcium is more useful than relying on correction alone.');
  }
  $('calciumOutput').innerHTML=listHTML(cOut);

  let pOut=[];
  if(pth===null){ pOut.push(status('PTH missing','amber'),'Order intact PTH with the repeat calcium.'); }
  else if(hyper && pthSuppressed){ pOut.push(status('PTH-independent branch','red'),`PTH ${pth} is suppressed for this calcium. Standard PHPT is unlikely.`); }
  else if(hyper && pthNonsuppressed){ pOut.push(status('PTH-dependent branch','blue'),`PTH ${pth} is not suppressed. A value inside the reference range is still physiologically inappropriate during hypercalcemia.`); }
  else if(clearlyNormalCa && pthHigh){ pOut.push(status('Elevated PTH with normal calcium','amber'),'Evaluate secondary hyperparathyroidism before considering normocalcemic PHPT.'); }
  else { pOut.push(status('Indeterminate','amber'),'Repeat paired calcium/PTH and interpret with assay ranges and clinical context.'); }
  if(checked('biotin')) pOut.push('Biotin can cause falsely low PTH in some assays; hold according to assay/lab guidance and repeat if needed.');
  $('pthOutput').innerHTML=listHTML(pOut);

  let dOut=[];
  if(hyper && pthNonsuppressed){
    dOut.push('<strong>PHPT is the leading diagnosis</strong> once persistence is confirmed, but the following must be addressed: FHH, thiazide/lithium effects, and tertiary HPT.');
    if(checked('dialysis')) dOut.push('Long-standing CKD/dialysis/transplant makes tertiary hyperparathyroidism a major alternative.');
    if(checked('thiazide')) dOut.push('Thiazide use can raise serum calcium and lower urine calcium.');
    if(checked('lithium')) dOut.push('Lithium can create PTH-dependent hypercalcemia and multigland disease.');
    if(checked('family') || $('caHistory').value==='lifelong') dOut.push('Lifelong/familial hypercalcemia substantially raises FHH probability.');
  } else if(hyper && pthSuppressed){
    dOut.push('<strong>Do not continue down a PHPT pathway.</strong> Use the clinical context to evaluate PTHrP/malignancy, vitamin D-mediated disease, granulomatous disease/lymphoma, medications/supplements, thyrotoxicosis, adrenal insufficiency, immobilization, and milk-alkali physiology.');
  } else if(clearlyNormalCa && pthHigh){
    const sec=[];
    if(vitd!==null && vitd<30) sec.push(`25-OH D ${vitd} (<30)`);
    if(egfr!==null && egfr<60) sec.push(`renal function ${egfr} (<60)`);
    if(checked('malabsorption')) sec.push('malabsorption/bariatric history');
    if(checked('lowCaIntake')) sec.push('low calcium intake');
    if(checked('antiresorptive')) sec.push('antiresorptive use');
    if(checked('lithium') || checked('thiazide')) sec.push('medication effect');
    dOut.push(sec.length ? `<strong>Secondary causes are present:</strong> ${sec.join(', ')}.` : 'No obvious secondary cause was entered, but normocalcemic PHPT still requires repeated normal total and ionized calcium plus elevated PTH over 3–6 months and a complete exclusion workup.');
  } else dOut.push('The current data do not establish a specific branch. Repeat paired calcium/PTH and confirm the calcium status.');
  $('diagnosisOutput').innerHTML=listHTML(dOut);

  let uOut=[];
  let cccr=null;
  if(urineCa!==null && urineCr!==null && serumCr!==null && ca!==null && urineCr>0 && ca>0){ cccr=(urineCa*serumCr)/(ca*urineCr); }
  if(urineCa!==null){
    uOut.push(`24-hour urine calcium: <strong>${urineCa} mg/day</strong>.`);
    if(sex==='female') uOut.push(urineCa>250 ? status('Above female hypercalciuria threshold','red') : status('Not above female surgical threshold','blue'));
    if(sex==='male') uOut.push(urineCa>300 ? status('Above male hypercalciuria threshold','red') : status('Not above male surgical threshold','blue'));
  }
  if(cccr!==null){
    uOut.push(`Calculated CCCR: <strong>${fmt(cccr,4)}</strong>.`);
    if(cccr<0.01) uOut.push('This favors FHH, but does not prove it.');
    else if(cccr>0.02) uOut.push('This favors PHPT, but does not exclude FHH.');
    else uOut.push('This is the indeterminate overlap range (0.01–0.02).');
  } else uOut.push('Enter urine calcium, urine creatinine, serum creatinine, and serum calcium to calculate CCCR.');
  const conf=[];
  if(checked('thiazide')) conf.push('thiazide'); if(checked('lithium')) conf.push('lithium'); if(vitd!==null && vitd<30) conf.push('vitamin D <30'); if(egfr!==null && egfr<60) conf.push('reduced kidney function'); if(checked('lowCaIntake')) conf.push('low calcium intake'); if($('collection').value==='questionable') conf.push('questionable collection');
  if(conf.length) uOut.push(`Urine calcium may be falsely low or difficult to interpret because of: ${conf.join(', ')}.`);
  $('urineOutput').innerHTML=listHTML(uOut);

  let criteria=[];
  const caForCriteria = corrected!==null ? corrected : ca;
  if(checked('symptomatic')) criteria.push('symptomatic/overt PHPT complication');
  if(caForCriteria!==null && cauln!==null && caForCriteria>cauln+1) criteria.push(`calcium >1.0 mg/dL above ULN (${fmt(caForCriteria)} vs ULN ${cauln})`);
  if(age!==null && age<50) criteria.push('age <50 years');
  if(egfr!==null && egfr<60) criteria.push('eGFR/CrCl <60 mL/min');
  if(checked('stone')) criteria.push('nephrolithiasis/nephrocalcinosis');
  if(checked('vertebral')) criteria.push('vertebral or low-trauma fracture');
  if(tScore!==null && tScore<=-2.5) criteria.push(`T-score ≤−2.5 (${tScore})`);
  if(urineCa!==null && sex==='female' && urineCa>250) criteria.push('urine calcium >250 mg/day (female threshold)');
  if(urineCa!==null && sex==='male' && urineCa>300) criteria.push('urine calcium >300 mg/day (male threshold)');
  if(criteria.length) $('surgeryOutput').innerHTML=status('At least one criterion met','green')+listHTML(criteria)+`<p class="small">If PHPT is confirmed and no contraindication exists, refer to an experienced parathyroid surgeon.</p>`;
  else $('surgeryOutput').innerHTML=status('No entered criterion identified','amber')+`<p>This does not mean surgery is inappropriate. Confirm that DXA, vertebral assessment, renal imaging, kidney function, urine calcium, age, and symptoms have all been evaluated. Surgery remains an option by shared decision.</p>`;

  let next=[];
  if(hyper && pthNonsuppressed){
    next.push('Repeat paired calcium/albumin and PTH on a second occasion at least 2 weeks apart if not already done.');
    next.push('Review thiazide, lithium, biotin, calcium/vitamin D supplements, renal history, and historical calcium values.');
    next.push('Obtain 25-OH vitamin D, kidney function, full 24-hour urine calcium/creatinine, three-site DXA, vertebral assessment as indicated, and renal imaging.');
    if(checked('family') || $('caHistory').value==='lifelong' || (cccr!==null && cccr<0.01)) next.push('Resolve FHH risk before surgery; consider family calcium testing and genetics.');
    if(criteria.length) next.push('Refer to an experienced parathyroid surgeon; order localization only after the operative decision.');
  } else if(hyper && pthSuppressed){
    next.push('Use a PTH-independent hypercalcemia workup driven by tempo and clinical context.');
    next.push('Consider PTHrP, 25-OH D, 1,25-(OH)2D, SPEP/free light chains, TSH, cortisol, medication/supplement review, and imaging only when clinically indicated.');
  } else if(clearlyNormalCa && pthHigh){
    next.push('Correct secondary causes and confirm normal ionized calcium.');
    next.push('Repeat PTH and calcium after correction; diagnosis requires persistence over 3–6 months.');
  } else next.push('Repeat paired calcium, albumin/ionized calcium, and PTH before labeling the disorder.');
  if(checked('pregnant')) next.push('Coordinate with maternal-fetal medicine and endocrine surgery; pregnancy changes medication and imaging choices.');
  $('nextOutput').innerHTML=listHTML(next);
  $('caseResult').classList.add('show');
  $('caseResult').scrollIntoView({behavior:'smooth',block:'nearest'});
}

$('interpretBtn').addEventListener('click',interpretCase);
$('resetBtn').addEventListener('click',()=>{ document.querySelectorAll('#interpreter input').forEach(x=>{ if(x.type==='checkbox') x.checked=false; else x.value=''; }); $('cauln').value='10.2'; $('pthlln').value='15'; $('pthuln').value='65'; $('sex').value=''; $('caHistory').value='unknown'; $('collection').value='unknown'; $('caseResult').classList.remove('show'); });

$('buildOrders').addEventListener('click',()=>{
  const selected=[...document.querySelectorAll('#orderList input:checked')].map(x=>'• '+x.dataset.order);
  $('ordersText').textContent=selected.length ? 'PHPT / hypercalcemia workup\n'+selected.join('\n') : 'No orders selected.';
});
$('copyOrders').addEventListener('click',()=>copyText('ordersText'));
function copyText(id){ navigator.clipboard.writeText($(id).innerText).then(()=>{ const old=$(id).style.outline; $(id).style.outline='2px solid #2b8a57'; setTimeout(()=>$(id).style.outline=old,700); }).catch(()=>{}); }
</script>
</body>
</html>

# PHPT Clinical Workflow

A static, interactive clinical study and workflow page for primary hyperparathyroidism.

## Publish with GitHub Pages

1. Create a GitHub repository.
2. Upload `index.html` to the repository root.
3. Open **Settings → Pages**.
4. Select **Deploy from a branch**, `main`, and `/ (root)`.
5. Save and wait for GitHub to publish the site.

The page runs entirely in the browser and does not transmit entered patient data. Do not enter identifiers or protected health information into a public/shared device.
